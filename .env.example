
#===========================================*#
#                 Postgres ENV               #
#===========================================*#

# Host/port for running Java directly. Compose overrides the bot to postgres:5432.
DB_HOST=127.0.0.1
DB_NAME=dailycode
DB_USER=dailycode
DB_PORT=5432
DB_PASSWORD=

# Use a bot token from the Discord Developer Portal;
DISCORD_TOKEN=

# Optional development server for immediate command updates. Leave blank in production.
# Commands are always registered globally and work in every server with the bot installed.
DISCORD_TEST_GUILD_ID=
