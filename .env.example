
#===========================================*#
#                 Postgres ENV               #
#===========================================*#

# Host/port for running Java directly. Compose overrides the bot to postgres:5432.
DB_HOST=127.0.0.1
DB_NAME=dailycode
DB_USER=dailycode
DB_PORT=5432
DB_PASSWORD=

# Use a bot token from the Discord Developer Portal;
DISCORD_TOKEN=

# Discord server ID where the bot registers and handles its slash commands.
DISCORD_TEST_GUILD_ID=
